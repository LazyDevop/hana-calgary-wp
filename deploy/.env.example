# Modèle du fichier .env à placer sur le VPS, à côté de docker-compose.yml
# (/opt/hana/staging/.env et /opt/hana/production/.env).
# Ne JAMAIS committer le vrai .env : il contient les mots de passe.
# Droits conseillés : chmod 600 .env

# --- Environnement -----------------------------------------------------------
HANA_ENV=staging                    # staging | production (nom du projet Docker)
# IMAGE_TAG est réécrit automatiquement à chaque déploiement (pas de commentaire sur cette ligne)
IMAGE_TAG=main
HTTP_PORT=8081                      # port local vers lequel le proxy HTTPS redirige
WP_HOME=https://dev.hanacalgary.ca  # production : https://www.hanacalgary.ca
WP_ENVIRONMENT_TYPE=staging         # production : production
WP_DEBUG=false
HANA_MAIL_DISABLED=1                # staging : 1 (aucun e-mail envoyé) — production : 0

# --- Base de données -----------------------------------------------------------
DB_NAME=hana
DB_USER=hana
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Données persistantes (chemins sur le VPS) -------------------------------
UPLOADS_DIR=./data/uploads          # doit appartenir à l'utilisateur 33 (www-data)
DB_DIR=./data/mysql

# --- E-mail (mot de passe de la boîte Titan contact@hanacalgary.ca) ----------
WPMS_SMTP_PASS=

# --- Clés de sécurité WordPress (une série différente par environnement) -----
# Générer : curl -s https://api.wordpress.org/secret-key/1.1/salt/
WORDPRESS_AUTH_KEY=
WORDPRESS_SECURE_AUTH_KEY=
WORDPRESS_LOGGED_IN_KEY=
WORDPRESS_NONCE_KEY=
WORDPRESS_AUTH_SALT=
WORDPRESS_SECURE_AUTH_SALT=
WORDPRESS_LOGGED_IN_SALT=
WORDPRESS_NONCE_SALT=
